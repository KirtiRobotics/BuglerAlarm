//Smart Dustbin
#include <Servo.h>
#define servopin 9
#define irpin 10
Servo myservo;
void setup() {
  // put your setup code here, to run once:
  myservo.attach(servopin);
  pinMode(irpin, INPUT);
  Serial.begin(9600);
}

void loop() {
  // put your main code here, to run repeatedly:
  int ir = digitalRead(irpin);
  Serial.print("IR state: ");
  Serial.println(ir);
  if (ir == 0) {
    myservo.write(90);
  } else {
    myservo.write(0);
  }
  delay(50);
}
